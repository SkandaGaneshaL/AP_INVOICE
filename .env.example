# OCI credentials and model configuration
OCI_COMPARTMENT_ID=
OCI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_EXC_REGION=ap-hyderabad-1
OCI_EXC_COMPARTMENT_ID=
PROJECT_ID=
OCI_AUTH=config
OCI_CONFIG_FILE=.oci/config
OCI_PROFILE=DEFAULT

# Keep extraction and reflection models separate
OCI_EXTRACTION_MODEL_ID=google.gemini-2.5-flash
OCI_EXTRACTION_REGION=ap-hyderabad-1
OCI_EXTRACTION_PROJECT_ID=
OCI_RULE_GENERATION_MODEL_ID=openai.gpt-oss-20b
OCI_RULE_GENERATION_GEMINI_MODEL_ID=google.gemini-2.5-flash
OCI_RULE_GENERATION_REGION=us-chicago-1
OCI_RULE_GENERATION_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_RULE_GENERATION_COMPARTMENT_ID=
# GPT-OSS 20B supports on-demand serving in us-chicago-1.
OCI_RULE_GENERATION_SERVING_MODE=on_demand
OCI_RULE_GENERATION_ENDPOINT_ID=
OCI_RULE_GENERATION_REASONING_EFFORT=low
# Application max-token limits are intentionally omitted; OCI manages output length.
OCI_RULE_GENERATION_GEMINI_SERVING_MODE=on_demand
OCI_RULE_GENERATION_GEMINI_ENDPOINT_ID=
OCI_GPT_RULE_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_GPT_RULE_MODEL_ID=openai.gpt-oss-20b
OCI_GPT_RULE_COMPARTMENT_ID=
OCI_GPT_RULE_PROJECT_ID=
OCI_GPT_RULE_SERVING_MODE=on_demand
OCI_GPT_RULE_ENDPOINT_ID=
OCI_GPT4O_RULE_REGION=us-chicago-1
OCI_GPT4O_RULE_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_GPT4O_RULE_MODEL_ID=openai.gpt-4o
OCI_GPT4O_RULE_COMPARTMENT_ID=
OCI_GPT4O_RULE_SERVING_MODE=on_demand
OCI_GPT4O_RULE_ENDPOINT_ID=
OCI_GEMINI_RULE_ENDPOINT=https://inference.generativeai.ap-hyderabad-1.oci.oraclecloud.com/openai/v1
OCI_GEMINI_RULE_MODEL_ID=google.gemini-2.5-flash
OCI_GEMINI_RULE_PROJECT_ID=
OCI_GEMINI_RULE_COMPARTMENT_ID=
OCI_REFLECTION_MODEL_ID=openai.gpt-4o

# Extraction limits
MAX_PDF_BYTES=20971520
MAX_PDF_PAGES=20
DOCUMENT_TTL_SECONDS=1800

# Streamlit -> FastAPI client timeouts (30 minutes maximum response wait)
STREAMLIT_REQUEST_TIMEOUT_SECONDS=1800
STREAMLIT_CONNECT_TIMEOUT_SECONDS=30

# GEPA is optional and review-only
AUTO_PERSIST_RULE_CANDIDATES=false
GEPA_ENABLED=false
GEPA_MAX_ITERATIONS=2
GEPA_MAX_METRIC_CALLS=5
GEPA_TIMEOUT_SECONDS=120
GEPA_MAX_REFLECTION_COST=1
GEPA_JOB_TTL_SECONDS=1800
GEPA_WORKER_COUNT=1
NORMAL_WORKER_COUNT=4
GEPA_VALIDATION_LIMIT=5
GEPA_RANDOM_SEED=0
STORE_FEEDBACK_DOCUMENTS=false
